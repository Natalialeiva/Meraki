# Solo evaluación local. Nunca apuntar esta configuración a una base histórica.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=meraki_evaluacion_capstone
DB_USER=postgres
DB_PASSWORD=
# El paso --configurar genera una clave aleatoria exclusiva para tu instalación.
SESSION_SECRET=
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
WEBPAY_RETURN_URL=http://localhost:3000/api/abonos/retorno/navegador
MERAKI_SUSCRIPCIONES_AUTOMATICAS=0
MERAKI_PROVEEDORES_EXTERNOS=0
# Opcionales: dejar vacíos durante evaluación. No se envían correos ni pagos.
MAIL_PROVIDER=gmail
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_TEST_TO=
